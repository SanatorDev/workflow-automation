# Copy to .env and fill in values. Never commit .env.
# Do not set NODE_ENV here — pnpm start:server sets production; leave unset for pnpm dev.

PORT=3000
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/DATABASE"
CLIENT_ORIGIN="http://localhost:4200"

# GitHub OAuth App — https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
# Authorization callback URL must match GITHUB_CALLBACK_URL.
# Local (Angular proxy): use the CLIENT_ORIGIN host so the session cookie stays on the same site.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required in production. Local default (if unset): ${CLIENT_ORIGIN}/api/auth/github/callback
GITHUB_CALLBACK_URL="http://localhost:4200/api/auth/github/callback"
# Public URL GitHub can POST webhooks to (no trailing slash).
# Required in production. Local default (if unset): http://localhost:${PORT}
PUBLIC_BASE_URL="http://localhost:3000"
# How webhooks are delivered:
#   forward — local testing with `gh webhook forward` (default when PUBLIC_BASE_URL is localhost;
#             only allowed with a localhost PUBLIC_BASE_URL — HMAC is skipped)
#   github  — register a real GitHub repo webhook (needs a publicly reachable PUBLIC_BASE_URL)
# WEBHOOK_DELIVERY=forward
# Required in production — random strings of at least 32 characters (not these placeholders).
SESSION_SECRET="change-me-to-a-long-random-string"
# Separate from SESSION_SECRET so either key can be rotated independently.
TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-string"

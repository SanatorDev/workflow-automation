{
  "name": "workflow-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Take-Home Exercise: Workflow Automation",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client start",
    "dev:server": "pnpm --filter server start",
    "dev:client": "pnpm --filter client start",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "start:server": "pnpm --filter server start:prod",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter client typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
